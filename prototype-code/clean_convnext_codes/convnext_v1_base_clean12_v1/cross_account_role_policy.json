{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListCardioSentryDatasetAndRuns",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cardiosentry",
      "Condition": {"StringLike": {"s3:prefix": ["dataset/*", "runs/*"]}}
    },
    {
      "Sid": "ReadCardioSentryDataset",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cardiosentry/dataset/*"
    },
    {
      "Sid": "ReadWriteCardioSentryRuns",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::cardiosentry/runs/*"
    }
  ]
}
