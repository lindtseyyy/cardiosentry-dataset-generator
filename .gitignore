# ---------------------------------------------------------------------------
# CardioSentry — what stays out of the repo
#
# This repo shares the DATASET GENERATOR (the pipeline code), not the data.
# Every dataset here is licence-gated (PhysioNet credentialed / DUA) and must
# be obtained by each user directly from the source. Nothing is redistributed.
# ---------------------------------------------------------------------------

# --- Python environment ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# --- Source datasets (~11 GB, licence-gated) ---
# Obtain your own copies and point config/paths.yaml at them.
dataset-files/

# --- Generated dataset artefacts (~57 GB, reproducible by running the pipeline) ---
dataset-combination-code/ecg_dataset_pipeline/data/

# --- Upstream third-party checkout (631 MB, clone it separately) ---
# https://github.com/alphanumericslab/ecg-image-kit
dataset-combination-code/ecg_dataset_pipeline/ecg-image-kit/

# --- Separate project with its own repo ---
# https://github.com/LedgeA/ECG-diagnosis-prototype
dataset-combination-code/ECG-diagnosis-prototype/

# --- Image pipeline build products ---
build/
dataset-combination-code/ecg_dataset_pipeline/image_pipeline/build.log

# --- Bulky generated reports (regenerated by a pipeline run) ---
# The small summary/audit reports in reports/ ARE committed, on purpose.
dataset-combination-code/ecg_dataset_pipeline/reports/extracted_candidates.csv
dataset-combination-code/ecg_dataset_pipeline/reports/excluded_records.csv
dataset-combination-code/ecg_dataset_pipeline/reports/signal_compatibility_report.csv
dataset-combination-code/ecg_dataset_pipeline/reports/harmonization_report.csv
dataset-combination-code/ecg_dataset_pipeline/reports/ambiguity_report.csv
dataset-combination-code/ecg_dataset_pipeline/reports/duplicate_patient_report.csv

